{
  "name": "draco-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Draco para Windows, com seletor de telas e janelas.",
  "author": "Cesar",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "npx --yes electron-builder@25.1.8 --win"
  },
  "devDependencies": {
    "electron": "^39.8.10"
  },
  "build": {
    "appId": "com.cesar.draco",
    "productName": "Draco",
    "artifactName": "draco-setup-${version}.${ext}",
    "files": ["main.js", "preload.js", "status.html", "icon.png"],
    "directories": {
      "output": "out"
    },
    "win": {
      "target": ["nsis"],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Draco"
    }
  }
}
