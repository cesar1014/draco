{
  "name": "draco",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Draco: voz, vídeo e compartilhamento de tela em grupo, direto entre os navegadores.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta npm:dev:server npm:dev:client",
    "dev:server": "node server/index.js --dev",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "share": "concurrently -k -n app,tunnel -c blue,green npm:start npm:tunnel",
    "lan": "npm run build && node server/index.js --https",
    "tunnel": "cloudflared tunnel --url http://localhost:3100",
    "icons": "node tools/make-icons.mjs",
    "app": "npm --prefix desktop start",
    "app:install": "cd desktop && npm install",
    "app:build": "npm --prefix desktop run dist",
    "test": "npm run typecheck && npm run test:server && npm run test:persistence && npm run test:media",
    "test:server": "node tools/test-signaling.mjs",
    "test:persistence": "node tools/test-persistence.mjs",
    "test:media": "node tools/test-media.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "11.7.0",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "helmet": "8.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "esbuild": "0.25.12",
    "selfsigned": "^5.5.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=20.17.0"
  }
}
