# ---------------------------------------------------------------------------
# Copie este arquivo para `.env` (sem o `.example`) e ajuste o que precisar.
# Em desenvolvimento o app roda em localhost sem `.env`. Produção exige as
# origens HTTPS e a chave de criptografia indicadas abaixo.
# ---------------------------------------------------------------------------

# Porta do servidor de sinalização e de produção. O Vite lê daqui também, pra
# apontar o proxy de dev pro lugar certo.
PORT=3100
# Atrás de Caddy/nginx na mesma máquina, exponha o Node só no loopback.
# Em desenvolvimento ele continua aceitando a rede local automaticamente.
HOST=127.0.0.1

# Arquivo SQLite. Caminhos relativos são resolvidos a partir da pasta onde o
# servidor foi iniciado. O padrão é data/draco.sqlite na raiz do projeto.
DATABASE_PATH=

# Quantidade de backups SQLite mantidos por `npm run db:backup` (padrão: 7).
# Os arquivos ficam em `backups/`, fora do Git. A cópia usa a API do SQLite e
# continua consistente mesmo com o servidor em execução e usando WAL.
BACKUP_RETENTION=7
# Chave AES-256 dos backups (32 bytes em base64url ou 64 caracteres hex).
# Guarde fora do servidor junto com uma cópia de recuperação da chave.
BACKUP_ENCRYPTION_KEY=

# Origem permitida pelo Socket.IO e pelas rotas /api. Em dev deixe vazio (libera
# localhost, o túnel e a rede local). Em produção é obrigatória e deve ser a
# URL HTTPS exata; aceita
# várias separadas por vírgula, pra o domínio e o túnel valerem ao mesmo tempo:
# ORIGIN=https://meu-app.trycloudflare.com,https://meuapp.duckdns.org
ORIGIN=

# Conta principal, criada no primeiro boot sem senha. O servidor envia um link
# para o e-mail abaixo; por esse link o dono define a própria senha.
SYSTEM_ADMIN_USERNAME=cesar1014
SYSTEM_ADMIN_EMAIL=xcesaryt@gmail.com
APP_URL=https://dracocall.duckdns.org

# SMTP usado para confirmar cadastro e troca de senha. Pode ser Gmail, Resend,
# Brevo ou qualquer serviço compatível. Senhas nunca são enviadas por e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=DracoCall <noreply@seudominio.com>

# Segredo que assina os tokens de sessão. Vazio = o servidor sorteia um no
# primeiro boot e o guarda no banco, o que basta pra uma instância só. Preencha
# (32 caracteres ou mais) quando o banco não for durável ou quando houver mais de
# uma instância, senão cada uma emitiria tokens que a outra recusa.
SESSION_SECRET=

# Criptografa mensagens de canal e privadas no SQLite com AES-256-GCM. É
# obrigatória em produção e deve ficar no cofre de secrets da hospedagem.
# Para rotacionar, mova a chave antiga para DATA_ENCRYPTION_PREVIOUS_KEYS até
# todos os registros terem sido recriptografados no boot.
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_PREVIOUS_KEYS=

# Cloudflare Turnstile. As duas devem ser configuradas juntas; a site key é
# pública e a secret key nunca é enviada ao navegador.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 1 quando houver um proxy na frente (Fly, Render, Cloudflare, nginx). Ele faz o
# limite por IP ler o `x-forwarded-for` em vez do endereço do proxy. Deixe 0 se o
# servidor recebe conexão direta: aí qualquer cliente poderia inventar o cabeçalho
# e escapar do rate limit trocando o valor.
TRUSTED_PROXY=0

# Volume do log: error, warn, info (padrão) ou debug.
LOG_LEVEL=

# ---------------------------------------------------------------------------
# TURN: necessário quando as pessoas estão em redes diferentes na internet.
# Só STUN resolve rede local e boa parte das redes domésticas, mas cerca de
# 1 em cada 5 conexões falha sem TURN (NAT simétrico, Wi-Fi corporativo, 4G).
# Escolha UM dos três modos abaixo.
# ---------------------------------------------------------------------------

# MODO 1: credencial fixa. Serve pra Cloudflare, Twilio, coturn com usuário
# estático, ou qualquer provedor que te dê usuário e senha. No Metered é o botão
# "Add Credential", mais simples que o modo 2, porque dispensa chave de API.
# Aceita vários endereços separados por vírgula, e vale usar: o `turns:` na 443
# sobre TCP é o que atravessa Wi-Fi corporativo que bloqueia UDP.
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# MODO 2: o servidor busca a credencial em runtime e repassa pro navegador.
# A chave de API fica aqui no servidor e nunca chega ao cliente.
# Open Relay (crie a conta em metered.ca/openrelay). Confira a quota do plano
# grátis no painel deles: é pequena e já mudou de valor mais de uma vez.
# TURN_CREDENTIALS_URL=https://SEUAPP.metered.live/api/v1/turn/credentials?apiKey=SUA_CHAVE
TURN_CREDENTIALS_URL=

# MODO 3: coturn com `use-auth-secret`. O servidor gera credencial temporária
# via HMAC. Use quando você mesmo hospeda o coturn.
# TURN_HOST=turn:seu-servidor.com:3478
# TURN_SECRET=o-mesmo-static-auth-secret-do-turnserver.conf
TURN_HOST=
TURN_SECRET=

# Força todo o tráfego por TURN (ignora conexão direta). Só pra depurar se o
# TURN está de fato funcionando. Deixe 0 no uso normal, gasta banda do relay.
TURN_ONLY=0

# ---------------------------------------------------------------------------
# SFU: mídia por servidor, pra calls maiores. Opcional.
#
# Em malha cada pessoa envia o próprio vídeo uma vez POR OUVINTE: numa call de
# seis, quem liga a câmera sobe cinco cópias dela. É o que faz o upload de casa
# não dar conta a partir de umas quatro pessoas.
#
# Com as credenciais abaixo a mídia sobe UMA vez pro SFU da Cloudflare, que
# replica pra todo mundo: 1080p pra oito pessoas custa a mesma banda que pra
# uma. Pegue as duas no painel: Cloudflare → Realtime → SFU → criar aplicação.
#
# O segredo fica só aqui, no servidor: o navegador nunca fala com a Cloudflare
# direto. Vazio = as calls seguem em malha, exatamente como sempre funcionaram.
# ---------------------------------------------------------------------------
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_APP_SECRET=

# ---------------------------------------------------------------------------
# Anexos: bucket S3 compatível (Cloudflare R2, AWS S3 ou equivalente).
# O navegador envia direto por URL assinada; o Node valida tamanho, extensão e
# assinatura mágica antes de publicar o anexo. Configure CORS do bucket para
# aceitar PUT da URL do Draco. Sem estas chaves, chat e DMs continuam normais.
# ---------------------------------------------------------------------------
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_REGION=auto
# Quota acumulada por conta; padrão de 1 GiB. O bucket deve permanecer privado.
OBJECT_STORAGE_USER_QUOTA_BYTES=1073741824

# Atualização automática do Electron só é ligada em builds assinados. O feed do
# electron-updater também confere o sha512 publicado junto do instalador.
DRACO_SIGNED_UPDATES=0
